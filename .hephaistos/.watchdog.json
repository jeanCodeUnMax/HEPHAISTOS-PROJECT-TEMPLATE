{
  "enabled": true,
  "master_file": ".hephaistos/master/PROJECT_MASTER.md",
  "require_initialized_project": true,
  "required_sections": [
    "MISSION",
    "HYPOTHESIS_ACTIVE",
    "EXPERIMENT_ACTIVE",
    "TASK_ACTIVE",
    "SUCCESS_CRITERION",
    "LAST_CONCLUSION",
    "NEXT_ACTION"
  ],
  "tests": { "commit": [], "push": ["npm test || echo 'No tests found'"] },
  "require_staged_changes_on_commit": true,
  "block_unresolved_conflicts": true,
  "show_master_before_gate": true,
  "protected_branches": ["main", "develop"]
}
